    "content_intake_analysis": { "class": "diagnosis", "requires": ["structured_output"], "thinking": "LOW", "maxOutputTokens": 8000, "timeoutMs": 180000, "maxAttempts": 2 },
    "destination_entity_resolution": { "class": "diagnosis", "requires": ["structured_output"], "thinking": "LOW", "maxOutputTokens": 8000, "timeoutMs": 180000, "maxAttempts": 2 },
    "content_brief": { "class": "planning", "requires": ["structured_output", "evidence_fidelity"], "thinking": "MEDIUM", "maxOutputTokens": 12000, "timeoutMs": 360000, "maxAttempts": 3 },
    "article_draft_v2": { "class": "writing", "requires": ["structured_output", "evidence_fidelity"], "thinking": "MEDIUM", "maxOutputTokens": 16000, "timeoutMs": 360000, "maxAttempts": 3 },
    "quality_review_v2": { "class": "qa", "requires": ["structured_output", "independent_review"], "thinking": "MEDIUM", "maxOutputTokens": 12000, "timeoutMs": 360000, "maxAttempts": 2 },
    "frontend_page_plan": { "class": "composition", "requires": ["structured_output", "contract_schema"], "thinking": "MEDIUM", "maxOutputTokens": 10000, "timeoutMs": 240000, "maxAttempts": 2 },
    "frontend_page_payload": { "class": "composition", "requires": ["structured_output", "contract_schema"], "thinking": "MEDIUM", "maxOutputTokens": 16000, "timeoutMs": 360000, "maxAttempts": 2 },
    "bounded_draft_repair": { "class": "repair", "requires": ["structured_output", "evidence_fidelity"], "thinking": "MEDIUM", "maxOutputTokens": 6000, "timeoutMs": 180000, "maxAttempts": 2 }
  }
