# Server
PORT=4310
HOST=127.0.0.1
DATABASE_PATH=./data/solo-to-china.sqlite
BACKUP_DIR=./backups
BACKUP_RETENTION=14
AUTO_BACKUP_HOURS=24
MAINTENANCE_ENABLED=true
MAINTENANCE_INTERVAL_MINUTES=15
KNOWLEDGE_RECONCILE_HOURS=24
JOB_HISTORY_RETENTION_DAYS=30
# Rolling job metrics shown in Maintenance.
TELEMETRY_WINDOW_HOURS=24
# Structured stdout logs. Use pretty for local reading, json for production ingestion.
LOG_LEVEL=info
LOG_FORMAT=json
# Set the same value in the extension options. Empty is allowed for localhost-only development.
CAPTURE_TOKEN=
ADMIN_TOKEN=

# Optional low-overhead exception alerts. Remote endpoints must use HTTPS.
EXCEPTION_WEBHOOK_URL=
EXCEPTION_WEBHOOK_TOKEN=
EXCEPTION_NOTIFICATION_MIN_SEVERITY=blocker
EXCEPTION_NOTIFICATION_INTERVAL_MINUTES=15
EXCEPTION_NOTIFICATION_REPEAT_HOURS=24
EXCEPTION_WEBHOOK_TIMEOUT_MS=10000

# AI enrichment (optional: capture still works without it)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_BASE_URL=https://api.openai.com/v1
AI_MAX_IMAGES=8

# Automatic content production. A candidate is created only after this many KB facts exist.
AUTO_CONTENT_MIN_FACTS=5
AUTO_CONTENT_MAX_PER_DESTINATION=1
CONTENT_STALE_AFTER_DAYS=365
CONTENT_VOLATILE_STALE_AFTER_DAYS=90

# WordPress draft-only delivery (optional)
WORDPRESS_SITE_URL=
WORDPRESS_USERNAME=
WORDPRESS_APPLICATION_PASSWORD=
WORDPRESS_INVENTORY_SYNC_HOURS=24
WORDPRESS_AUTHOR_ID=
WORDPRESS_CATEGORY_IDS=
WORDPRESS_TAG_IDS=
WORDPRESS_FEATURED_MEDIA_ID=
WORDPRESS_TEMPLATE=
# blocks emits native Gutenberg block markup; html keeps plain safe HTML.
WORDPRESS_CONTENT_FORMAT=blocks
# Optional REST-exposed custom meta keys for the SEO plugin used by the site.
WORDPRESS_SEO_TITLE_META_KEY=
WORDPRESS_SEO_DESCRIPTION_META_KEY=

# Optional read-only Google Search Console inventory for query-level cannibalization protection.
# Grant the service account read access to this exact URL-prefix or sc-domain property.
SEARCH_CONSOLE_SITE_URL=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
SEARCH_CONSOLE_SYNC_HOURS=24
SEARCH_CONSOLE_LOOKBACK_DAYS=28
SEARCH_CONSOLE_ROW_LIMIT=5000
SEARCH_CONSOLE_MIN_IMPRESSIONS=10

# Commercial overlay (never read by Research/Knowledge/Content planning)
COMMERCIAL_MAX_OFFERS_PER_DRAFT=3
AFFILIATE_DISCLOSURE=SoloToChina may earn a commission from eligible bookings, at no extra cost to you.
