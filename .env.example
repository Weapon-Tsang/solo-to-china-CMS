# Server
PORT=4310
HOST=127.0.0.1
DATABASE_PATH=./data/solo-to-china.sqlite
SOURCE_UPLOADS_DIR=./data/source-uploads
BACKUP_DIR=./backups
BACKUP_RETENTION=14
AUTO_BACKUP_HOURS=24
MAINTENANCE_ENABLED=true
MAINTENANCE_INTERVAL_MINUTES=15
KNOWLEDGE_RECONCILE_HOURS=24
ENTITY_RESOLUTION_HOURS=24
JOB_HISTORY_RETENTION_DAYS=30
# Rolling job metrics shown in Maintenance.
TELEMETRY_WINDOW_HOURS=24
# Structured stdout logs. Use pretty for local reading, json for production ingestion.
LOG_LEVEL=info
LOG_FORMAT=json

# Manual source ingestion. Values are bytes except the timeout (milliseconds), image count, and bucket name.
MANUAL_SOURCE_REQUEST_TIMEOUT_MS=20000
MANUAL_SOURCE_MAX_FILE_BYTES=12582912
MANUAL_SOURCE_MAX_IMAGE_BYTES=6291456
MANUAL_SOURCE_MAX_VIDEO_BYTES=104857600
MANUAL_SOURCE_MAX_TOTAL_BYTES=115343360
MANUAL_SOURCE_MAX_REMOTE_BYTES=8388608
MANUAL_SOURCE_MAX_IMAGES=8
# Required to process uploaded videos above the safe inline-request size. The VM service account needs object create/delete access.
MANUAL_SOURCE_GCS_BUCKET=
# Set the same value in the extension options. Empty is allowed for localhost-only development.
CAPTURE_TOKEN=
ADMIN_TOKEN=
# When set, this Cloudflare Tunnel hostname exposes only extension capture/status routes; it must use CAPTURE_TOKEN.
CAPTURE_HOST=

# Optional low-overhead exception alerts. Remote endpoints must use HTTPS.
EXCEPTION_WEBHOOK_URL=
EXCEPTION_WEBHOOK_TOKEN=
EXCEPTION_NOTIFICATION_MIN_SEVERITY=blocker
EXCEPTION_NOTIFICATION_INTERVAL_MINUTES=15
EXCEPTION_NOTIFICATION_REPEAT_HOURS=24
EXCEPTION_WEBHOOK_TIMEOUT_MS=10000

# Kimi enrichment (optional: capture still works without it)
# Create this server-side key at platform.kimi.com. Never put it in the extension.
KIMI_API_KEY=
# The dashboard's default research / writing selection is Kimi K3.
AI_MODEL=vertex-gemini-3.8-flash
KIMI_MODEL=kimi-k3
# China Kimi Open Platform (platform.kimi.com). Set https://api.moonshot.ai/v1 only for an international platform.kimi.ai account.
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MAX_IMAGES=8
KIMI_MAX_COMPLETION_TOKENS=16000
# K2.7 Code vision + reasoning requests may take longer than ordinary chat. Six minutes avoids premature extraction failures.
KIMI_REQUEST_TIMEOUT_MS=360000
# Image downloads run in parallel; skip an unavailable image after 20 seconds instead of holding up the note.
KIMI_IMAGE_TIMEOUT_MS=20000

# Reader-facing SEO / GEO metadata. The canonical content site is usually the WordPress origin, not this dashboard origin.
PUBLIC_CONTENT_SITE_URL=
CONTENT_PUBLISHER_NAME=SoloToChina
CONTENT_PUBLISHER_LOGO_URL=

# Optional original editorial images on Google Cloud. Image generation is off by default. Only non-factual illustrations may be generated automatically.
IMAGE_ENABLED=false
IMAGE_PROVIDER=vertex_gemini
# The dashboard default is Nano Banana 2. Kimi K3 remains a research/writing model because its API does not output image files.
VISUAL_MODEL=vertex-gemini-3.1-flash-image
IMAGE_MODEL=gemini-3.1-flash-image
IMAGE_COVER_QUALITY=1K
IMAGE_INLINE_QUALITY=1K
# Legacy aliases remain supported for existing deployments: VISUAL_PROVIDER and VERTEX_IMAGEN_MODEL.
VISUAL_PROVIDER=none
GOOGLE_CLOUD_PROJECT=
VERTEX_AI_LOCATION=global
VERTEX_IMAGEN_MODEL=imagen-4.0-generate-001
GENERATED_MEDIA_DIR=./data/generated-media
PUBLIC_BASE_URL=
VERTEX_IMAGE_TIMEOUT_MS=120000

# Automatic content production. A candidate is created only after this many KB facts exist.
AUTO_CONTENT_MIN_FACTS=5
AUTO_CONTENT_MAX_PER_DESTINATION=1
CONTENT_STALE_AFTER_DAYS=365
CONTENT_VOLATILE_STALE_AFTER_DAYS=90

# Frontend Capability Contract. The audited Frontend artifacts are
# contracts/component-registry.json and contracts/page-schema.json at commit 210d0fe.
# Keep blank until that Frontend release is deployed and reviewed; never point at source folders.
FRONTEND_CONTRACT_SOURCE_REPOSITORY=
FRONTEND_COMPONENT_REGISTRY_SOURCE=
FRONTEND_PAGE_SCHEMA_SOURCE=
FRONTEND_CONTRACT_COMMIT_SHA=
FRONTEND_CONTRACT_SYNC_HOURS=6
FRONTEND_CONTRACT_TIMEOUT_MS=15000

# WordPress draft-only delivery (optional)
WORDPRESS_SITE_URL=
WORDPRESS_USERNAME=
WORDPRESS_APPLICATION_PASSWORD=
WORDPRESS_INVENTORY_SYNC_HOURS=24
WORDPRESS_AUTHOR_ID=
WORDPRESS_CATEGORY_IDS=
WORDPRESS_TAG_IDS=
WORDPRESS_FEATURED_MEDIA_ID=
WORDPRESS_TEMPLATE=
# blocks emits native Gutenberg block markup; html keeps plain safe HTML.
WORDPRESS_CONTENT_FORMAT=blocks
# Optional REST-exposed custom meta keys for the SEO plugin used by the site.
WORDPRESS_SEO_TITLE_META_KEY=
WORDPRESS_SEO_DESCRIPTION_META_KEY=
# Optional REST-exposed WordPress meta key used by your SEO plugin for the JSON-LD package.
WORDPRESS_SCHEMA_JSONLD_META_KEY=
# Optional REST-exposed WordPress meta key for the Content Strategy version carried by the draft payload.
WORDPRESS_STRATEGY_VERSION_META_KEY=

# Optional read-only Google Search Console inventory for query-level cannibalization protection.
# Grant the service account read access to this exact URL-prefix or sc-domain property.
SEARCH_CONSOLE_SITE_URL=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
SEARCH_CONSOLE_SYNC_HOURS=24
SEARCH_CONSOLE_LOOKBACK_DAYS=28
SEARCH_CONSOLE_ROW_LIMIT=5000
SEARCH_CONSOLE_MIN_IMPRESSIONS=10

# Commercial overlay (never read by Research/Knowledge/Content planning)
COMMERCIAL_MAX_OFFERS_PER_DRAFT=3
AFFILIATE_DISCLOSURE=SoloToChina may earn a commission from eligible bookings, at no extra cost to you.
