{
  "manifest_version": 3,
  "name": "Save to SoloToChina",
  "version": "1.5.0",
  "description": "Manually save the currently open Xiaohongshu note to the SoloToChina research engine.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "http://127.0.0.1:4310/*",
    "http://localhost:4310/*"
  ],
  "action": {
    "default_title": "Save to SoloToChina",
    "default_popup": "popup.html"
  }
}
