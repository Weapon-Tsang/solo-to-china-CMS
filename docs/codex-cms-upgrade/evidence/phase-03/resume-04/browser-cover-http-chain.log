    await page.getByRole('button',{name:'重新检查候选',exact:true}).click();await page.waitForTimeout(500);
  }
  await page.getByText('当前封面：cover-visual · 已锁定 · 接收端回执已确认',{exact:true}).waitFor();
  await page.screenshot({path:'output/playwright/phase03-browser-cover-delivery.png'});
  await page.reload();await page.getByRole('tab',{name:'内容',exact:true}).click();
  await page.getByRole('button',{name:'Cover selection fixture Draft'}).click();
  await page.getByText('独立封面 · 本地预览与选择',{exact:true}).click();
  await page.getByText('当前封面：cover-visual · 已锁定 · 接收端回执已确认',{exact:true}).waitFor();
  if(errors.length||outbound.length)throw Error(JSON.stringify({errors,outbound}));
  return {status:'PASS',scope:'cover-only browser upload, adoption, crop and loopback delivery; not WordPress',layouts,requests,dimensions,body_preserved:true,errors,outbound};
