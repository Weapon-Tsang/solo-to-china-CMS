  for(const [name,value] of [['主体左边界 %','40'],['主体上边界 %','40'],['主体宽度 %','20'],['主体高度 %','20'],['焦点横向 %','50'],['焦点纵向 %','50']])
    await page.getByRole('spinbutton',{name,exact:true}).fill(value);
  await page.getByRole('button',{name:'生成封面预览',exact:true}).click();
  const img=page.getByRole('img',{name:/16:9封面预览/});await img.waitFor();await img.evaluate(img=>img.decode());
  const dimensions=await img.evaluate(img=>[img.naturalWidth,img.naturalHeight]);
  if(dimensions[0]/dimensions[1]!==16/9)throw Error(JSON.stringify(dimensions));
  await page.getByRole('checkbox',{name:'已检查预览，主体完整且清晰',exact:true}).check();
  await page.getByRole('button',{name:'确认保存封面',exact:true}).click();
  await page.getByText('封面已保存到本地。接收端能力待验证，新交付保持阻断。',{exact:true}).waitFor();
